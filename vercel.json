{
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/output.css",
      "headers": {
        "Content-Type": "text/css; charset=utf-8"
      },
      "dest": "/public/output.css"
    },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ]
}